# ==============================================================================
# GymFlow (IaaS) - Environment Variables Template
# Stack: Next.js 15 (Serverless) + Neon Postgres + PWA
# Copy this file to .env and configure your credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neon Serverless PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Primary Connection String (Pooled via PgBouncer for Server Actions & API Routes)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-patient-shape-bcvc57iq-pooler.c-16.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Direct / Unpooled Connection String (Used for Database Migrations via Drizzle / Prisma)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-patient-shape-bcvc57iq.c-16.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Extracted Neon PostgreSQL Connection Parameters
PGHOST="ep-patient-shape-bcvc57iq-pooler.c-16.us-east-1.aws.neon.tech"
PGPORT=5432
PGDATABASE="neondb"
PGUSER="neondb_owner"
PGPASSWORD="YOUR_PASSWORD_HERE"
PGSSLMODE="require"

# ------------------------------------------------------------------------------
# 2. Next.js Application & Deployment Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="GymFlow"
NEXT_PUBLIC_APP_TAGLINE="Elevate Your Strength & Peak Performance"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY_SYMBOL="PKR "
NEXT_PUBLIC_CURRENCY_CODE="PKR"

# ------------------------------------------------------------------------------
# 3. Authentication & Security (Auth.js / NextAuth / Lucia)
# ------------------------------------------------------------------------------
AUTH_SECRET="generate_a_random_32_character_string_here"
NEXTAUTH_SECRET="generate_a_random_32_character_string_here"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Serverless Automated Background Cron & Webhook Security
# ------------------------------------------------------------------------------
CRON_SECRET="generate_a_random_secure_cron_token"

# ------------------------------------------------------------------------------
# 5. Legacy PHP / Local MySQL Fallback (For Current Codebase Compatibility)
# ------------------------------------------------------------------------------
GYMFLOW_DB_HOST=127.0.0.1
GYMFLOW_DB_PORT=3306
GYMFLOW_DB_NAME=gym_flow
GYMFLOW_DB_USERNAME=root
GYMFLOW_DB_PASSWORD=
