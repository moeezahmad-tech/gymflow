{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "GymFlow Member App",
  "short_name": "GymFlow",
  "description": "GymFlow Mobile Member App - Turnstile Gate Pass, Workouts, Check-in Streak & Membership Hub",
  "start_url": "./app/index.php",
  "scope": "./",
  "id": "com.gymflow.app",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#050507",
  "theme_color": "#dc2626",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["fitness", "health", "lifestyle", "sports"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "assets/images/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/icons/maskable-icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Member Portal",
      "short_name": "Portal",
      "description": "Access your member workouts, streak & entry QR",
      "url": "./user/index.php",
      "icons": [{ "src": "assets/images/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Login",
      "short_name": "Login",
      "description": "Sign in to your GymFlow account",
      "url": "./login.php",
      "icons": [{ "src": "assets/images/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Membership Pricing",
      "short_name": "Plans",
      "description": "Explore gym packages & tiers in PKR",
      "url": "./pricing.php",
      "icons": [{ "src": "assets/images/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Contact Support",
      "short_name": "Contact",
      "description": "Get in touch with coaching staff",
      "url": "./contact.php",
      "icons": [{ "src": "assets/images/icons/icon-96x96.png", "sizes": "96x96" }]
    }
  ]
}
