# ============================================================
# GymFlow - Production Apache Configuration & Clean URLs
# ============================================================

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block access to sensitive and private files
    RewriteRule ^\.(env|git|github|gitinfo) - [F,L,NC]
    RewriteRule \.(sql|bak|log)$ - [F,L,NC]
    RewriteRule ^cron/ - [F,L,NC]

    # 2. Redirect external requests with .php to extensionless URLs
    # Excludes index.php to prevent DirectoryIndex loops
    RewriteCond %{THE_REQUEST} !/index\.php [NC]
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # 3. Resolve extensionless URL to corresponding .php file
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

# MIME Types for PWA, Fonts & Modern Formats
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest .json
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType font/woff2 .woff2
</IfModule>
