# ============================================================
# GymFlow - Production Apache Configuration & Clean URLs
# ============================================================

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block access to sensitive files
    RewriteRule ^\.(env|git|github|gitinfo) - [F,L,NC]
    RewriteRule \.(sql|bak|log)$ - [F,L,NC]
    RewriteRule ^cron/ - [F,L,NC]

    # 2. If requested path is a real file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Rewrite extensionless requests (e.g. /about -> /about.php)
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

# MIME Types
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest .json
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType font/woff2 .woff2
</IfModule>
